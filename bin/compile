#!/bin/bash
# Docker buildpack compile script
# Scalingo will handle docker build automatically with this buildpack present

BUILD_DIR=$1
CACHE_DIR=$2
ENV_DIR=$3

echo "-----> Docker buildpack detected"
echo "-----> Using Dockerfile for application build"
echo "-----> Dockerfile will be built by Scalingo's Docker builder"

# Exit successfully - Scalingo's Docker builder handles the rest
exit 0
