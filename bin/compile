#!/bin/bash
set -e

BUILD_DIR=$1
CACHE_DIR=$2
ENV_DIR=$3

cd "$BUILD_DIR"

echo "-----> FrankenPHP Buildpack"
echo "-----> Installing FrankenPHP binary..."

# Download FrankenPHP static binary
FRANKENPHP_VERSION="1.2.1"
FRANKENPHP_URL="https://github.com/dunglas/frankenphp/releases/download/v${FRANKENPHP_VERSION}/frankenphp-${FRANKENPHP_VERSION}-linux-x86_64-musl.tar.gz"

mkdir -p /app/bin
cd /tmp
curl -fsSL "$FRANKENPHP_URL" -o frankenphp.tar.gz

if [ $? -ne 0 ]; then
    echo "ERROR: Failed to download FrankenPHP"
    exit 1
fi

tar -xzf frankenphp.tar.gz -C /app/bin/
rm frankenphp.tar.gz

if [ ! -f "/app/bin/frankenphp" ]; then
    echo "ERROR: FrankenPHP binary not found after extraction"
    exit 1
fi

chmod +x /app/bin/frankenphp
echo "-----> FrankenPHP binary installed successfully"

# Install PHP dependencies
if [ -f "$BUILD_DIR/composer.json" ]; then
    echo "-----> Installing PHP dependencies..."
    cd "$BUILD_DIR"

    # Download composer if not present
    if [ ! -f "composer.phar" ]; then
        curl -fsSL https://getcomposer.org/installer | php -- --quiet
    fi

    php composer.phar install --no-dev --optimize-autoloader

    if [ $? -ne 0 ]; then
        echo "WARNING: Composer install had issues, but continuing..."
    fi
fi

echo "-----> Build complete!"
exit 0
