#!/bin/bash
set -e

BUILD_DIR=$1
CACHE_DIR=$2
ENV_DIR=$3

cd "$BUILD_DIR"

echo "-----> FrankenPHP Buildpack"
echo "-----> Installing FrankenPHP and dependencies..."

# Parse composer.json for PHP version
PHP_VERSION="8.5"
if [ -f "composer.json" ]; then
    # Try jq first, fall back to grep
    if command -v jq >/dev/null 2>&1; then
        php_requirement=$(jq -r '.require.php // empty' composer.json 2>/dev/null)
    else
        php_requirement=$(grep -o '"php"[[:space:]]*:[[:space:]]*"[^"]*' composer.json 2>/dev/null | head -1 | grep -o '"[^"]*"$' | tr -d '"')
    fi

    if [ ! -z "$php_requirement" ]; then
        extracted_version=$(echo "$php_requirement" | grep -oE '[89]\.[0-9]+' | head -1)
        if [ ! -z "$extracted_version" ]; then
            PHP_VERSION="$extracted_version"
        fi
    fi
fi

echo "-----> Detected PHP version requirement: $PHP_VERSION"

# Architecture
ARCH=$(uname -m)
if [ "$ARCH" != "x86_64" ] && [ "$ARCH" != "aarch64" ]; then
    echo "ERROR: Unsupported architecture: $ARCH"
    exit 1
fi

if getconf GNU_LIBC_VERSION >/dev/null 2>&1; then
    LIBC="gnu"
else
    LIBC="musl"
fi

INSTALL_DIR="$BUILD_DIR/bin"
mkdir -p "$INSTALL_DIR"

# Download FrankenPHP
echo "-----> Downloading FrankenPHP (${ARCH}-${LIBC})..."
BINARY_NAME="frankenphp-linux-${ARCH}-${LIBC}"
BINARY_URL="https://github.com/dunglas/frankenphp/releases/latest/download/${BINARY_NAME}"

if ! curl -fsSL "$BINARY_URL" -o "$INSTALL_DIR/frankenphp"; then
    echo "ERROR: Failed to download FrankenPHP"
    exit 1
fi

chmod +x "$INSTALL_DIR/frankenphp"
echo "✓ FrankenPHP installed"

# PHP CLI and Composer are installed by apt buildpack
echo "-----> Verifying PHP CLI and Composer (from apt buildpack)..."

if ! command -v php >/dev/null 2>&1; then
    echo "ERROR: php not found. Ensure apt buildpack is configured with php-cli"
    exit 1
fi

if ! command -v composer >/dev/null 2>&1; then
    echo "ERROR: composer not found. Ensure apt buildpack is configured with composer"
    exit 1
fi

PHP_BIN="php"
echo "✓ PHP $(php -v | head -1) available"
echo "✓ Composer available"

# Install PHP dependencies with Composer (optional - can be pre-installed in vendor/)
if [ -f "$BUILD_DIR/composer.json" ]; then
    echo "-----> Installing PHP dependencies with Composer..."

    cd "$BUILD_DIR"

    echo "Running: composer install --no-dev --optimize-autoloader"
    if composer install --no-dev --optimize-autoloader 2>&1; then
        echo "✓ PHP dependencies installed with Composer"
    else
        composer_exit=$?
        echo ""
        echo "⚠ Warning: Composer install failed (exit code $composer_exit)"
        echo ""
        if [ -d "vendor" ] && [ -f "vendor/autoload.php" ]; then
            echo "✓ Vendor directory exists - proceeding with existing dependencies"
        else
            echo "ℹ Note: vendor/ directory not found"
            echo "  To fix this, you can:"
            echo "  1. Run 'composer install' locally and commit vendor/"
            echo "  2. Or commit composer.lock and include vendor in git"
            echo ""
            echo "  For now, proceeding without installed dependencies..."
            echo "  Your app may fail to start if dependencies are required."
        fi
    fi
fi

# Create application directories
mkdir -p /app/storage /app/bootstrap/cache 2>/dev/null || true
chmod -R 755 /app/storage /app/bootstrap/cache 2>/dev/null || true

# Create profile.d script to set PATH for FrankenPHP at runtime
mkdir -p /app/.profile.d
cat > /app/.profile.d/frankenphp.sh <<'PROFILE_EOF'
export PATH="/app/bin:$PATH"
PROFILE_EOF
chmod +x /app/.profile.d/frankenphp.sh

echo "-----> FrankenPHP buildpack complete!"
exit 0
