#!/bin/bash
set -e

BUILD_DIR=$1
CACHE_DIR=$2
ENV_DIR=$3

cd "$BUILD_DIR"

echo "-----> FrankenPHP Buildpack"

# Install PHP dependencies via composer
if [ -f "$BUILD_DIR/composer.json" ]; then
    echo "-----> Installing PHP dependencies..."

    # Download composer if not present
    if [ ! -f "composer.phar" ]; then
        curl -fsSL https://getcomposer.org/installer | php -- --quiet
    fi

    php composer.phar install --no-dev --optimize-autoloader

    if [ $? -ne 0 ]; then
        echo "ERROR: Composer install failed"
        exit 1
    fi

    echo "-----> PHP dependencies installed"
fi

# Create required directories
mkdir -p /app/storage /app/bootstrap/cache 2>/dev/null || true
chmod -R 755 /app/storage /app/bootstrap/cache 2>/dev/null || true

echo "-----> FrankenPHP buildpack ready"
exit 0
