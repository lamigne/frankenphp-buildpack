#!/bin/bash
set -e

BUILD_DIR=$1
CACHE_DIR=$2
ENV_DIR=$3

cd "$BUILD_DIR"

echo "-----> FrankenPHP Buildpack"
echo "-----> Installing FrankenPHP and dependencies..."

# Parse composer.json for PHP version
PHP_VERSION="8.5"
if [ -f "composer.json" ] && command -v jq >/dev/null 2>&1; then
    php_requirement=$(jq -r '.require.php // .require."php-x64" // empty' composer.json 2>/dev/null)
    if [ ! -z "$php_requirement" ]; then
        # Extract version from constraint like ">=8.4" or "^8.4"
        extracted_version=$(echo "$php_requirement" | grep -oE '8\.[0-9]+' | head -1)
        if [ ! -z "$extracted_version" ]; then
            PHP_VERSION="$extracted_version"
        fi
    fi
fi

echo "-----> Detected PHP version requirement: $PHP_VERSION"

# Download FrankenPHP
ARCH=$(uname -m)
if [ "$ARCH" = "aarch64" ]; then
    ARCH="aarch64"
elif [ "$ARCH" = "x86_64" ]; then
    ARCH="x86_64"
else
    echo "ERROR: Unsupported architecture: $ARCH"
    exit 1
fi

if getconf GNU_LIBC_VERSION >/dev/null 2>&1; then
    LIBC="gnu"
else
    LIBC="musl"
fi

BINARY_NAME="frankenphp-linux-${ARCH}-${LIBC}"
BINARY_URL="https://github.com/dunglas/frankenphp/releases/latest/download/${BINARY_NAME}"
INSTALL_DIR="/app/bin"

mkdir -p "$INSTALL_DIR"

echo "-----> Downloading FrankenPHP (${ARCH}-${LIBC})..."
if ! curl -fsSL "$BINARY_URL" -o "$INSTALL_DIR/frankenphp"; then
    echo "ERROR: Failed to download FrankenPHP from $BINARY_URL"
    exit 1
fi

chmod +x "$INSTALL_DIR/frankenphp"
echo "✓ FrankenPHP installed"

# Download PHP CLI from ondrej/php repository
echo "-----> Downloading PHP ${PHP_VERSION} CLI from ondrej/php..."
PHP_PKG="php${PHP_VERSION}-cli"
PHP_DEB_URL="https://ppa.launchpadcontent.net/ondrej/php/ubuntu/pool/main/p/php${PHP_VERSION}/${PHP_PKG}_${PHP_VERSION}*_amd64.deb"

# Try to find and download the latest PHP package
PHP_DEB=$(curl -s "https://ppa.launchpadcontent.net/ondrej/php/ubuntu/pool/main/p/php${PHP_VERSION}/" | grep -oE "${PHP_PKG}_[^/]*_amd64\.deb" | tail -1)

if [ -z "$PHP_DEB" ]; then
    echo "ERROR: Could not find PHP ${PHP_VERSION} package from ondrej/php"
    exit 1
fi

PHP_DEB_FULL_URL="https://ppa.launchpadcontent.net/ondrej/php/ubuntu/pool/main/p/php${PHP_VERSION}/${PHP_DEB}"

if ! curl -fsSL "$PHP_DEB_FULL_URL" -o "/tmp/${PHP_DEB}"; then
    echo "ERROR: Failed to download PHP from ondrej/php"
    exit 1
fi

# Install PHP .deb
echo "-----> Installing PHP ${PHP_VERSION} CLI..."
if ! dpkg -i "/tmp/${PHP_DEB}" 2>/dev/null; then
    echo "WARNING: dpkg install had issues, but continuing..."
fi

rm -f "/tmp/${PHP_DEB}"

# Verify PHP is available
if ! command -v "php${PHP_VERSION}" >/dev/null 2>&1; then
    echo "ERROR: PHP ${PHP_VERSION} CLI not found after installation"
    exit 1
fi

PHP_BIN="php${PHP_VERSION}"
echo "✓ PHP ${PHP_VERSION} CLI installed"
export PHP_BIN

# Download Composer
echo "-----> Downloading Composer..."
if ! curl -fsSL https://getcomposer.org/download/latest-stable/composer.phar -o "$INSTALL_DIR/composer"; then
    echo "ERROR: Failed to download Composer"
    exit 1
fi

chmod +x "$INSTALL_DIR/composer"
echo "✓ Composer installed"

# Install PHP dependencies
if [ -f "composer.json" ]; then
    echo "-----> Installing PHP dependencies with Composer..."

    if ! "$PHP_BIN" "$INSTALL_DIR/composer" install --no-dev --optimize-autoloader; then
        echo "ERROR: Composer install failed"
        exit 1
    fi

    echo "✓ PHP dependencies installed"
fi

# Create application directories (for Laravel, etc.)
mkdir -p /app/storage /app/bootstrap/cache 2>/dev/null || true
chmod -R 755 /app/storage /app/bootstrap/cache 2>/dev/null || true

echo "-----> FrankenPHP buildpack complete!"
exit 0
