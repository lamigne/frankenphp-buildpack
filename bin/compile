#!/bin/bash
set -e

BUILD_DIR=$1
CACHE_DIR=$2
ENV_DIR=$3

cd "$BUILD_DIR"

echo "-----> FrankenPHP Buildpack"
echo "-----> Installing FrankenPHP and dependencies..."

# Parse composer.json for PHP version
PHP_VERSION="8.5"
if [ -f "composer.json" ]; then
    # Try jq first, fall back to grep
    if command -v jq >/dev/null 2>&1; then
        php_requirement=$(jq -r '.require.php // empty' composer.json 2>/dev/null)
    else
        php_requirement=$(grep -o '"php"[[:space:]]*:[[:space:]]*"[^"]*' composer.json 2>/dev/null | head -1 | grep -o '"[^"]*"$' | tr -d '"')
    fi

    if [ ! -z "$php_requirement" ]; then
        extracted_version=$(echo "$php_requirement" | grep -oE '[89]\.[0-9]+' | head -1)
        if [ ! -z "$extracted_version" ]; then
            PHP_VERSION="$extracted_version"
        fi
    fi
fi

echo "-----> Detected PHP version requirement: $PHP_VERSION"

# Architecture
ARCH=$(uname -m)
if [ "$ARCH" != "x86_64" ] && [ "$ARCH" != "aarch64" ]; then
    echo "ERROR: Unsupported architecture: $ARCH"
    exit 1
fi

if getconf GNU_LIBC_VERSION >/dev/null 2>&1; then
    LIBC="gnu"
else
    LIBC="musl"
fi

INSTALL_DIR="/app/bin"
mkdir -p "$INSTALL_DIR"

# Download FrankenPHP
echo "-----> Downloading FrankenPHP (${ARCH}-${LIBC})..."
BINARY_NAME="frankenphp-linux-${ARCH}-${LIBC}"
BINARY_URL="https://github.com/dunglas/frankenphp/releases/latest/download/${BINARY_NAME}"

if ! curl -fsSL "$BINARY_URL" -o "$INSTALL_DIR/frankenphp"; then
    echo "ERROR: Failed to download FrankenPHP"
    exit 1
fi

chmod +x "$INSTALL_DIR/frankenphp"
echo "✓ FrankenPHP installed"

# Download PHP CLI - try official PHP.net binaries first (often statically linked)
echo "-----> Downloading PHP ${PHP_VERSION} CLI..."

# Try official PHP.net prebuilt static binaries first
PHP_BINS_URL="https://github.com/php/php-src/releases/download/php-${PHP_VERSION}.0/php-${PHP_VERSION}.0-linux-x86_64.tar.gz"
PHP_BIN_TMP="/tmp/php-bin.tar.gz"

echo "Attempting to download from official PHP releases..."
if curl -fsSL --head "$PHP_BINS_URL" 2>/dev/null | head -1 | grep -q "200"; then
    echo "Found official PHP binary, downloading..."
    if curl -fsSL "$PHP_BINS_URL" -o "$PHP_BIN_TMP"; then
        echo "Extracting PHP binary..."
        tar -xzf "$PHP_BIN_TMP" -C "$INSTALL_DIR/" --strip-components=1 bin/php 2>/dev/null || true
        PHP_BIN="$INSTALL_DIR/php"

        if [ -f "$PHP_BIN" ]; then
            chmod +x "$PHP_BIN"
        fi
    fi
fi

# Fall back to ondrej/php if official binary not available
if [ ! -f "$PHP_BIN" ]; then
    echo "Official binary not available, falling back to ondrej/php..."

    PHP_DEB_DIR="/tmp/php-debs"
    mkdir -p "$PHP_DEB_DIR"

    # Download and parse Packages.xz
    REPO_URL="https://ppa.launchpadcontent.net/ondrej/php/ubuntu/dists/jammy/main/binary-amd64/"

    echo "Fetching ondrej/php package list..."
    if ! curl -fsSL "${REPO_URL}Packages.xz" | xz -d 2>/dev/null | grep -A 15 "^Package: php${PHP_VERSION}-cli$" > /tmp/php-cli-info.txt; then
        echo "ERROR: PHP ${PHP_VERSION}-cli not found"
        exit 1
    fi

    if [ ! -s /tmp/php-cli-info.txt ]; then
        echo "ERROR: PHP ${PHP_VERSION} not available in ondrej/php repository"
        exit 1
    fi

    PHP_DEB_PATH=$(grep "^Filename:" /tmp/php-cli-info.txt | head -1 | awk '{print $2}')
    if [ -z "$PHP_DEB_PATH" ]; then
        echo "ERROR: Could not parse PHP package filename"
        exit 1
    fi

    PHP_DEB=$(basename "$PHP_DEB_PATH")
    echo "Found: $PHP_DEB"

    # Download and extract
    mkdir -p "$PHP_DEB_DIR/php-root"
    PHP_DEB_URL="https://ppa.launchpadcontent.net/ondrej/php/ubuntu/${PHP_DEB_PATH}"

    echo "Downloading PHP ${PHP_VERSION} CLI..."
    if ! curl -fsSL "$PHP_DEB_URL" -o "$PHP_DEB_DIR/${PHP_DEB}"; then
        echo "ERROR: Failed to download PHP package"
        exit 1
    fi

    dpkg -x "$PHP_DEB_DIR/${PHP_DEB}" "$PHP_DEB_DIR/php-root" 2>/dev/null || true

    # Copy binary and libraries
    if [ -f "$PHP_DEB_DIR/php-root/usr/bin/php${PHP_VERSION}" ]; then
        cp "$PHP_DEB_DIR/php-root/usr/bin/php${PHP_VERSION}" "$INSTALL_DIR/php"
        chmod +x "$INSTALL_DIR/php"
        PHP_BIN="$INSTALL_DIR/php"
    elif [ -f "$PHP_DEB_DIR/php-root/usr/bin/php" ]; then
        cp "$PHP_DEB_DIR/php-root/usr/bin/php" "$INSTALL_DIR/php"
        chmod +x "$INSTALL_DIR/php"
        PHP_BIN="$INSTALL_DIR/php"
    fi

    # Copy libraries from extracted package
    if [ -d "$PHP_DEB_DIR/php-root/usr/lib" ]; then
        mkdir -p "$INSTALL_DIR/lib"
        cp -r "$PHP_DEB_DIR/php-root/usr/lib/"* "$INSTALL_DIR/lib/" 2>/dev/null || true
    fi
fi

# Verify PHP binary was installed
if [ ! -f "$PHP_BIN" ]; then
    echo "ERROR: PHP binary not found after installation"
    exit 1
fi

echo "✓ PHP ${PHP_VERSION} CLI downloaded"

# Create symlinks for version mismatches (e.g., PHP built against libxml2.so.2 but system has libxml2.so.16)
echo "Linking system libraries for PHP compatibility..."
mkdir -p "$INSTALL_DIR/lib"

# Link common library version mismatches
for lib_name in libxml2 libssl libcrypto; do
    # Find what versions the system has
    for lib_path in /usr/lib/x86_64-linux-gnu/${lib_name}.so*; do
        if [ -f "$lib_path" ]; then
            lib_basename=$(basename "$lib_path")
            # Create symlink in our lib directory
            ln -sf "$lib_path" "$INSTALL_DIR/lib/$lib_basename" 2>/dev/null || true
        fi
    done
done

# Verify PHP works (with library path set)
export LD_LIBRARY_PATH="$INSTALL_DIR/lib:$LD_LIBRARY_PATH"

if ! "$PHP_BIN" -v > /dev/null 2>&1; then
    echo "ERROR: PHP binary verification failed"
    echo "Debug: attempting to resolve missing libraries..."

    # Find missing libraries from ldd output
    missing_libs=$(ldd "$PHP_BIN" 2>&1 | grep "not found" | awk '{print $1}')
    for missing_lib in $missing_libs; do
        echo "  Missing: $missing_lib"
        # Try to find the library on the system
        found_lib=$(ldconfig -p 2>/dev/null | grep "/$missing_lib" | head -1 | awk '{print $NF}')
        if [ ! -z "$found_lib" ]; then
            echo "    Found at: $found_lib"
            # Create symlink
            ln -sf "$found_lib" "$INSTALL_DIR/lib/$missing_lib" 2>/dev/null || true
        fi
    done

    # Try again
    if ! "$PHP_BIN" -v > /dev/null 2>&1; then
        echo "ERROR: Still cannot run PHP binary"
        ldd "$PHP_BIN" 2>&1 || true
        exit 1
    fi
fi

echo "✓ PHP ${PHP_VERSION} CLI installed and verified"
export PHP_BIN

# Download Composer
echo "-----> Downloading Composer..."
if ! curl -fsSL https://getcomposer.org/download/latest-stable/composer.phar -o "$INSTALL_DIR/composer"; then
    echo "ERROR: Failed to download Composer"
    exit 1
fi

chmod +x "$INSTALL_DIR/composer"
echo "✓ Composer installed"

# Install PHP dependencies
if [ -f "$BUILD_DIR/composer.json" ]; then
    echo "-----> Installing PHP dependencies with Composer..."

    cd "$BUILD_DIR"
    export PATH="$INSTALL_DIR:$PATH"
    export LD_LIBRARY_PATH="$INSTALL_DIR/lib:$LD_LIBRARY_PATH"

    if ! "$PHP_BIN" "$INSTALL_DIR/composer" install --no-dev --optimize-autoloader; then
        echo "ERROR: Composer install failed"
        exit 1
    fi

    echo "✓ PHP dependencies installed"
fi

# Create application directories
mkdir -p /app/storage /app/bootstrap/cache 2>/dev/null || true
chmod -R 755 /app/storage /app/bootstrap/cache 2>/dev/null || true

# Create profile.d script to set LD_LIBRARY_PATH at runtime
mkdir -p /app/.profile.d
cat > /app/.profile.d/php-libs.sh <<'PROFILE_EOF'
export LD_LIBRARY_PATH="/app/bin/lib:$LD_LIBRARY_PATH"
export PATH="/app/bin:$PATH"
PROFILE_EOF
chmod +x /app/.profile.d/php-libs.sh

echo "-----> FrankenPHP buildpack complete!"
exit 0
