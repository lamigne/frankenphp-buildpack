# Aptfile for FrankenPHP on Scalingo
# Copy this to your app as 'Aptfile'
# The buildpack will parse composer.json for PHP version

# Add ondrej/php repository (for latest PHP versions)
ondrej/php-ppa

# PHP CLI and extensions (adjust version to match your needs)
# Examples: php8.4-cli, php8.5-cli, etc.
php8.4-cli
php8.4-common
php8.4-mbstring
php8.4-xml
php8.4-curl
php8.4-zip

# Optional: additional extensions as needed
# php8.4-pdo
# php8.4-mysql
# php8.4-sqlite3
# php8.4-redis
