# Example Caddyfile for FrankenPHP
# Copy this to your FrankenPHP app and name it 'Caddyfile'

{
	admin off
	# Thread pool sized by the buildpack from CONTAINER_MEMORY (see README);
	# fallbacks match an S container.
	frankenphp {
		num_threads {$FRANKENPHP_NUM_THREADS:4}
		max_threads {$FRANKENPHP_MAX_THREADS:8}
	}
	log {
		output stdout
		format console
	}
}

# Scalingo assigns the public port through $PORT; fall back to 8080 locally.
:{$PORT:8080} {
	root * /app/public

	encode gzip

	# Serve static files directly, route everything else to index.php,
	# and execute PHP in-process (no PHP-FPM needed with FrankenPHP)
	php_server
}
